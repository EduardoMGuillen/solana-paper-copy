# Copia este archivo como .env.local (en tu PC) y llena los valores.
# .env.local nunca se sube a GitHub. En la VM estas variables van en /etc/solana-bot.env.

# --- Modo sombra: costos reales de Jupiter, sin firmar nada ---
LIVE_MODE=shadow
# API key gratuita del portal de desarrolladores de Jupiter (https://developers.jup.ag)
JUPITER_API_KEY=

# --- Alertas por Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcionales ---
# RPC propio de Solana (Helius/QuickNode). Si está vacío se usa el RPC público, que basta para leer decimales.
SOLANA_RPC_URL=
# Contraseña del dashboard. En tu PC (localhost) no hace falta.
BOT_PASSWORD=
