# Copia este archivo como .env.local (en tu PC) y llena los valores.
# .env.local nunca se sube a GitHub. En la VM estas variables van en /etc/solana-bot.env.

# --- Modo sombra: costos reales de Jupiter, sin firmar nada ---
LIVE_MODE=shadow
# API key gratuita del portal de desarrolladores de Jupiter (https://developers.jup.ag)
JUPITER_API_KEY=

# --- Alertas por Telegram (opcional) ---
# Solo Meteora live: al abrir, al cerrar, y cada 15 min el estado de las abiertas.
# Ese mismo chat puede pedir saldo, estado, cerrar y stop. No puede encender el bot. El papel no escribe aquí.
# El destino es TELEGRAM_CHAT_ID de la cuenta que pulsó Start en el bot, no un número de teléfono.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcionales ---
# RPC propio de Solana (Helius/QuickNode). Si está vacío se usa el RPC público, que basta para leer decimales y el saldo de la wallet.
SOLANA_RPC_URL=
# Carpeta de la wallet dedicada. Si está vacía se usa ~/.solana-paper-bot, fuera del repositorio.
# El panel solo lee la dirección. No firma en ningún modo.
# WALLET_DIR=
# Contraseña del dashboard. En tu PC (localhost) no hace falta.
BOT_PASSWORD=
