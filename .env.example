# Configuración de PolloTraderBot.
# - App de escritorio: este archivo es config.env en la carpeta de datos (bandeja → "Abrir configuración").
#   Reinicia la app (bandeja → Salir) para que tome los cambios.
# - npm run dev: cópialo como .env.local. En la VM estas variables van en /etc/solana-bot.env.
# Nunca se sube a GitHub.

# --- Alertas por Telegram (opcional) ---
# Solo Meteora live: al abrir, al cerrar, y cada 15 min el estado de las abiertas.
# Ese mismo chat puede pedir saldo, estado, cerrar y stop. No puede encender el bot.
# El destino es TELEGRAM_CHAT_ID de la cuenta que pulsó Start en el bot, no un número de teléfono.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Meteora live: límites duros. La web no los puede cambiar ---
# Meteora live firma con la wallet dedicada solo mientras está encendido y no existe el archivo KILL.
# Tope de SOL en posiciones abiertas, y SOL que nunca se toca.
LIVE_LP_MAX_SOL=0.3
LIVE_MIN_SOL_RESERVE=0.03
# Impacto máximo al abrir y al vender el token sobrante (150 = 1.5%), y slippage (100 = 1%).
LIVE_MAX_PRICE_IMPACT_BPS=150
LIVE_MAX_SLIPPAGE_BPS=100
# Priority fee en micro-lamports por unidad de cómputo. 20000 cuesta ~0.00001 SOL por transacción.
LIVE_PRIORITY_MICROLAMPORTS=20000
# Renta de bin arrays nuevos que se acepta pagar al abrir (0.0714 SOL cada uno, no se recupera).
# 0 = no abrir rangos que obliguen a crearlos.
LIVE_MAX_BIN_ARRAY_RENT_SOL=0
# Bins máximos por posición. 69 = solo posiciones estándar (pools de 2% o más).
# 200 deja entrar pools de 0.8%, 1% y 1.25% con el rango completo del 75%;
# el alquiler extra (~0.04 SOL en un pool de 1%) vuelve al cerrar.
LIVE_MAX_POSITION_BINS=200

# --- Opcionales ---
# RPC propio de Solana (Helius/QuickNode). Con Meteora live encendido se recomienda uno propio:
# el público limita las consultas justo cuando hay que cerrar.
SOLANA_RPC_URL=
# Con Helius, la app agrega rebate-address a la URL: Helius reparte reembolsos de MEV
# (backrun) de tus swaps a esa wallet. Por defecto va a la wallet del autor del programa,
# J723mhkAUyjKrR469XfHeMC2wGfcCU6EACMQtW6dQDBd. Pon tu propia dirección para cobrarlos tú,
# u "off" para no enviarlo. No cambia el precio ni la ejecución de tus operaciones.
# HELIUS_REBATE_ADDRESS=
# Carpeta de la wallet dedicada. Si está vacía se usa ~/.solana-paper-bot, fuera del repositorio.
# El panel solo lee la dirección. Solo el bot de Meteora live abre la clave.
# WALLET_DIR=
# Contraseña del dashboard. En tu PC y en la app de escritorio (localhost) no hace falta.
BOT_PASSWORD=
