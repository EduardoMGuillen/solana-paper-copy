# PolloTraderBot configuration.
# - Desktop app: this file is config.env in the data folder (tray → "Open config folder").
#   Restart the app (tray → Quit) to pick up changes.
# - npm run dev: copy it to .env.local. On the VM these variables go in /etc/solana-bot.env.
# Never committed to GitHub.

# --- Telegram alerts (optional) ---
# Meteora live only: on open, on close, and every 15 min the status of open positions.
# The same chat can ask for balance, status, close and stop. It cannot start the bot.
# The target is the TELEGRAM_CHAT_ID of the account that pressed Start in the bot, not a phone number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Meteora live: hard limits. The web UI cannot change them ---
# Meteora live signs with the dedicated wallet only while running and when there is no KILL file.
# Cap on SOL in open positions, and SOL that is never touched.
LIVE_LP_MAX_SOL=0.3
LIVE_MIN_SOL_RESERVE=0.03
# Max price impact when opening and when selling the leftover token (150 = 1.5%), and slippage (100 = 1%).
LIVE_MAX_PRICE_IMPACT_BPS=150
LIVE_MAX_SLIPPAGE_BPS=100
# Priority fee in micro-lamports per compute unit. 20000 costs ~0.00001 SOL per transaction.
LIVE_PRIORITY_MICROLAMPORTS=20000
# Rent for new bin arrays the bot may pay when opening (0.0714 SOL each, never returned).
# 0 = do not open ranges that require creating them.
LIVE_MAX_BIN_ARRAY_RENT_SOL=0
# Max bins per position. 69 = standard positions only (pools of 2% or more).
# 200 lets 0.8%, 1% and 1.25% pools in with the full 75% range;
# the extra rent (~0.04 SOL on a 1% pool) comes back on close.
LIVE_MAX_POSITION_BINS=200

# --- Optional ---
# Your own Solana RPC (Helius/QuickNode). Recommended while Meteora live is running:
# the public one rate-limits right when positions need closing.
SOLANA_RPC_URL=
# With Helius, the app adds rebate-address to the URL: Helius pays MEV (backrun) rebates
# from your swaps to that wallet. By default they go to the program author's wallet,
# J723mhkAUyjKrR469XfHeMC2wGfcCU6EACMQtW6dQDBd. Set your own address to collect them,
# or "off" to not send it. It does not change the price or execution of your trades.
# HELIUS_REBATE_ADDRESS=
# Dedicated wallet folder. If empty, ~/.solana-paper-bot is used, outside the repository.
# The dashboard only reads the address. Only the Meteora live bot opens the key.
# WALLET_DIR=
# Dashboard password. Not needed on your PC or in the desktop app (localhost).
BOT_PASSWORD=
